# =========================================
# 光合創學營運管理系統 - 環境變數範本
# =========================================
# 使用說明：複製此檔案為 .env 並填入實際值
#   cp .env.example .env

# ── Supabase ─────────────────────────────
# 取得位置：https://supabase.com/dashboard/project/{PROJECT_ID}/settings/api

# Project URL（格式：https://xxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon public key（格式：eyJ... 或 sb_publishable_...）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Resend（自動寄信）─────────────────────
# 取得位置：https://resend.com/api-keys（免費額度 3000 封/月）
# 沒設定時系統不會寄信，僅在 email_logs 留 'skipped' 紀錄（dev 安全網）
RESEND_API_KEY=

# 寄件人地址（需在 Resend 驗證過 domain），預設值為 fallback
EMAIL_FROM=noreply@guanghe-crm.vercel.app

# 內部通知收件人（合約被拒簽時會寄一封給這裡）
# 沒設時拒簽通知會跳過（不影響簽署主流程）
INTERNAL_NOTIFY_EMAIL=

# 每日摘要收件人（多人用逗號分隔）— sendDailyDigest 用
NOTIFICATION_RECIPIENTS=

# ── Vercel Cron 鑑權（選填）───────────────
# 設了之後 /api/cron/* 端點需要帶 Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=
